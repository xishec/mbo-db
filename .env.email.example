# Copy this file to .env.email.local and replace the placeholder values.
# .env.email.local is ignored by Git because its name ends in .local.

# Gmail SMTP authentication (use a Gmail app password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-new-app-password

# Single recipient or a comma-separated list
RECIPIENT_EMAIL=recipient@example.com

# Local Firebase credentials (this JSON file is already ignored by Git)
FIREBASE_SERVICE_ACCOUNT_PATH=./mbodatabase-firebase-adminsdk-fbsvc-7647ed8475.json

# Optional overrides; these are the defaults shown here for clarity
FIREBASE_DATABASE_URL=https://mbodatabase-default-rtdb.firebaseio.com
FIREBASE_ENVIRONMENT=prod
