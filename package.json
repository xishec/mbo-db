{
  "name": "mbo-db",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "semi": true,
    "trailingComma": "es5"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "lint": "eslint .",
    "parse": "npm run parse:alpha && npm run parse:prod",
    "parse:alpha": "cross-env NODE_ENV=development npx tsx scripts/import.ts && npm run generate:DETs:dev",
    "parse:prod": "cross-env NODE_ENV=production npx tsx scripts/import.ts && npm run generate:DETs:prod",
    "generate:DETs": "npm run generate:DETs:dev",
    "generate:DETs:dev": "cross-env NODE_ENV=development npx tsx scripts/generateDETsMap.ts",
    "generate:DETs:prod": "cross-env NODE_ENV=production npx tsx scripts/generateDETsMap.ts",
    "build": "cross-env NODE_ENV=production tsc -b && vite build && electron-builder",
    "build:web": "tsc -b && vite build --config vite.config.web.ts",
    "build:dir": "cross-env NODE_ENV=production tsc -b && vite build && electron-builder --dir",
    "build:mac": "cross-env NODE_ENV=production tsc -b && vite build && electron-builder --mac",
    "build:win": "cross-env NODE_ENV=production tsc -b && vite build && electron-builder --win",
    "build:all": "cross-env NODE_ENV=production tsc -b && vite build && electron-builder -mw",
    "deploy": "npm run build:web && firebase deploy --only hosting",
    "generate:icons": "npx tsx scripts/generate-icons.ts",
    "generate:icns": "bash scripts/generate-icns.sh",
    "generate:ico": "npx tsx scripts/generate-ico.ts"
  },
  "main": "dist-electron/main.cjs",
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@heroui/react": "^2.8.5",
    "@react-stately/data": "^3.14.1",
    "dotenv": "^17.2.3",
    "firebase": "^12.6.0",
    "firebase-admin": "^13.6.0",
    "framer-motion": "^11.18.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.22",
    "cross-env": "^10.1.0",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.mbo.db",
    "productName": "MBO Database",
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "icon": "public/mbo-logo.svg",
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "public/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  }
}
