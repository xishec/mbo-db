{
  "rules": {
    "alpha": {
      ".read": true,
      ".write": "auth != null",
      "birdEventsMap": {
        ".indexOn": ["syncedAt", "date"]
      }
    },
    "prod": {
      ".read": true,
      ".write": "auth != null",
      "birdEventsMap": {
        ".indexOn": ["syncedAt", "date"]
      }
    },
    "constants": {
      ".read": true,
      ".write": "auth != null"
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    }
  }
}
